{
  "name": "surge-conf",
  "displayName": "Surge Configuration",
  "description": "Syntax highlighting and formatting for Surge configuration files",
  "version": "0.0.1",
  "publisher": "cyrus",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "surge",
    "proxy",
    "network",
    "configuration"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "surge",
        "aliases": [
          "Surge",
          "surge"
        ],
        "extensions": [
          ".dconf",
          ".sgmodule"
        ],
        "firstLine": "^#!MANAGED-CONFIG|^\\[General\\]",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "surge",
        "scopeName": "source.surge",
        "path": "./syntaxes/surge.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/grammar.test.js && node ./out/test/formatter.test.js",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
